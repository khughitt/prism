+"""Saved evidence must identify real blocking work, not just report a generic gap."""
+import copy,json,os,signal,tempfile,time,unittest,uuid
+os.umask(0o077)
+from pathlib import Path
+from unittest.mock import patch
+import capture,logs,phases,controller
+
+class PhaseCheck(unittest.TestCase):
+ def case(self,operation='archive',effect='slow',seed=False):
+  with tempfile.TemporaryDirectory() as tmp:
+   root=Path(tmp);log=root/'source.log';log.write_bytes(b'')
+   cfg={'schema':2,'runId':'phase-case','clockOrigin':'linux-monotonic','socket':'prism-budget-capture-phase-case','environment':'synthetic','deadlineSeconds':2700,'pollSeconds':.01,'maxGapSeconds':.05 if effect=='slow' else 2,'log':str(log)}
+   for k in ('manifest','control','receipt','heartbeat','polls','identities'):cfg[k]=str(root/(k+'.json'))
+   capture.atomic(root/'RUN.json',cfg);capture.atomic(root/'wrapper-ready.json',{});capture.atomic(root/'identities.json',{'wrapper':capture.process(os.getpid())});capture.atomic(root/'control.json',{'sequence':1,'command':'stop' if effect=='stop' else 'finish'})
+   real_start=logs.start;real_sync=os.fsync;real_hash=logs.hashlib.sha256;real_checkpoint=logs.Capture.checkpoint;fired=[];active=[False];matches=[0]
+   def start(*args):
+    real_start(*args)
+    if seed:
+     owner=logs.Capture(root/'manifest.json')
+     try:
+      for i in range(4):
+       log.write_bytes(b'captured\n');owner.poll()
+       if i<3:log.replace(root/'source.log.1');log.write_bytes(b'')
+     finally:owner.close()
+    else:
+     with log.open('ab') as f:f.write(b'captured\n')
+   def sync(fd):
+    name=Path(os.readlink(f'/proc/self/fd/{fd}')).name
+    match=name.endswith('.raw') if operation=='archive' else name==operation+'.json' if operation=='polls' else name==operation+'.tmp'
+    if match:matches[0]+=1
+    if match and not fired and (operation!='heartbeat' or matches[0]==2):
+     fired.append(True)
+     if effect=='slow':time.sleep(.08)
+     real_sync(fd)
+     if effect=='error':raise OSError('controlled fsync failure')
+     if effect=='signal':raise capture.Interrupted('SIGTERM')
+    else:real_sync(fd)
+   def checkpoint(owner,*args,**kwargs):
+    active[0]=True
+    try:return real_checkpoint(owner,*args,**kwargs)
+    finally:active[0]=False
+   def hashed(*args,**kwargs):
+    if seed and active[0]:time.sleep(.015)
+    return real_hash(*args,**kwargs)
+   traps={s:signal.getsignal(s) for s in (signal.SIGTERM,signal.SIGINT,signal.SIGHUP)}
+   try:
+    with patch.object(logs,'start',start),patch.object(os,'fsync',sync),patch.object(logs.Capture,'checkpoint',checkpoint),patch.object(logs.hashlib,'sha256',hashed):result=capture.run_collector(root/'RUN.json')
+   finally:
+    for s,h in traps.items():signal.signal(s,h)
+   receipt=json.loads((root/'collector-receipt.json').read_text());rows=[json.loads(x) for x in (root/'polls.json').read_text().splitlines()]
+   self.assertTrue(fired or seed);self.assertEqual(result,0 if effect=='normal' else 1);self.assertEqual(receipt['integrityComplete'],effect=='normal')
+   if os.environ.get('PHASE_CHECK_PROOFS'):
+    dest=Path(os.environ['PHASE_CHECK_PROOFS'])/(operation+'-'+effect+'-'+str(seed)+'-'+uuid.uuid4().hex);dest.mkdir(parents=True,mode=0o700)
+    (dest/'evidence.json').write_text(json.dumps({'rows':rows,'receipt':receipt},indent=2)+'\n')
+   return rows,receipt
+ def test_real_archive_fsync_cost_identified_after_gap(self):
+  rows,receipt=self.case()
+  self.assertIn('gap',receipt['error'])
+  found=[op for row in rows for op in row.get('phases',{}).get('operations',[]) if op['name']=='archive.fsync' and op['max']['end']-op['max']['start']>=.08]
+  self.assertTrue(found,'saved evidence cannot identify the actual slow archive fsync')
+
+ def test_persistence_cost_failure_and_signal_are_carried(self):
+  for effect in ('slow','error','signal'):
+   with self.subTest(effect=effect):
+    rows,receipt=self.case('polls',effect)
+    p=receipt['lastIntervalPersistence'];self.assertEqual(p['persistedObservationStart'],rows[-1]['start'])
+    phases.validate(p)
+    op=next(x for x in p['phases']['operations'] if x['name']=='poll.fsync')
+    self.assertEqual(op['failures'],int(effect!='slow'))
+    if effect=='slow':self.assertGreaterEqual(op['max']['end']-op['max']['start'],.08)
+    else:self.assertIn('SIGTERM' if effect=='signal' else 'controlled fsync failure',receipt['error'])
