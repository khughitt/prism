+def production_contract(receipt,duration,rate):
+    c.require(receipt['complete'] is True and receipt['exitReason']=='complete','producer incomplete or interrupted')
+    c.require(receipt['starts']==1,'producer restart')
+    c.require(receipt['ended']-receipt['started']>=duration,'short producer lifetime')
+    c.require(receipt['ended']<receipt['deadline'],'producer deadline')
+    c.require(receipt['bytes']>=math.ceil(duration*rate),'silently reduced producer rate')
+    return True
+
+def poll_contract(rows,receipt,gap):
+    c.require(bool(rows),'missing polls')
+    persists=[x['previousIntervalPersistence'] for x in rows if x.get('previousIntervalPersistence') is not None]
+    if receipt.get('lastIntervalPersistence') is not None:persists.append(receipt['lastIntervalPersistence'])
+    c.require(len(persists)==len(rows),'missing persistence coverage')
+    c.require(len({x['persistedObservationStart'] for x in persists})==len(rows),'duplicate persistence coverage')
+    for row,p in zip(rows,persists):
+        c.require(row['start']==p['persistedObservationStart'] and row['end']==p['start'] and p['end']>=p['start']>=row['start'],'persistence identity/order')
