+ seen_h=set();anchors=set();by_start={row['start']:p for row,p in zip(rows,persists)}
+ for h in heartbeats:
+  validate(h);key=(h['runId'],h['clockOrigin'],h['start']);require(key not in seen_h,'duplicate heartbeat');seen_h.add(key)
+  require((h['runId'],h['clockOrigin'])==(receipt['runId'],receipt['clockOrigin']) and h['observation']=='heartbeat' and h['bytes']==0 and h['checkpoint'] is False,'heartbeat identity')
+  anchor=h['precedingPollStart'];require(anchor not in anchors,'duplicate heartbeat anchor');anchors.add(anchor)
+  if anchor is None:require(h['startup'] is True and h['end']<=rows[0]['start'],'startup linkage')
+  else:
+   number(anchor);require(h['startup'] is False and anchor in by_start and by_start[anchor]['end']<=h['start'],'heartbeat linkage')
+  require(all(op['name'].startswith('heartbeat.') for op in h['phases']['operations']),'heartbeat operation scope')
+ return {'collection':len(rows),'persistence':len(persists),'heartbeat':len(heartbeats)}
