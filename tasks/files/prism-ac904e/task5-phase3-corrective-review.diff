+ if receipt.get('lastHeartbeat') is not None:heartbeats.append(receipt['lastHeartbeat'])
+ require(len(persists)==len(rows),'persistence coverage')
+ for row,p in zip(rows,persists):
+  validate(p);require(all(op['name'].startswith('poll.') for op in p['phases']['operations']),'persistence operation scope');require(p['observation']=='persistence' and (p['runId'],p['clockOrigin'],p['persistedObservationStart'],p['start'])==(row['runId'],row['clockOrigin'],row['start'],row['end']),'persistence linkage')
