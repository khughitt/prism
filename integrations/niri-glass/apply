#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { generatedPath } from '../../src/paths.js';
import { renderGlassConfig } from './render.js';

const resolved = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const target = generatedPath('niri-glass.json');
fs.mkdirSync(path.dirname(target), { recursive: true });
const tmp = `${target}.${process.pid}.tmp`;
fs.writeFileSync(tmp, JSON.stringify(renderGlassConfig(resolved), null, 2) + '\n');
fs.renameSync(tmp, target);
